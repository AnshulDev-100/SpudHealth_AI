# Backend API Configuration
# Copy this file to .env and update the URL based on your backend choice

# Option 1: Simple Backend (main.py)
# REACT_APP_API_URL=http://127.0.0.1:4000/predict

# Option 2: TF Serving Backend (tf-serving-main.py) - Recommended
REACT_APP_API_URL=http://127.0.0.1:8002/predict